<!DOCTYPE html>
<html>
<head>
    <title>Student Skill & Internship Tracker</title>
</head>

<body style="margin:0;
             font-family:Arial, sans-serif;
             background:#f4f7f2;">

    <!-- HEADER -->
    <div style="background:#ffffff;
                padding:18px 45px;
                box-shadow:0 2px 8px rgba(0,0,0,0.08);">

        <div style="font-size:26px;
                    font-weight:bold;
                    color:#14532d;">
            Skill<span style="color:#16a34a;">Track</span>
        </div>

    </div>


    <!-- MAIN SECTION -->
    <div style="min-height:88vh;
                display:flex;
                justify-content:center;
                align-items:center;">

        <div style="width:90%;
                    max-width:900px;
                    background:#ffffff;
                    padding:50px;
                    box-sizing:border-box;
                    text-align:center;
                    border-radius:14px;
                    box-shadow:0 8px 25px rgba(0,0,0,0.08);">

            <h1 style="color:#14532d;
                       font-size:38px;
                       margin-bottom:12px;">
                Student Skill & Internship Tracker
            </h1>

            <p style="color:#6b7280;
                      font-size:18px;
                      line-height:1.6;
                      max-width:650px;
                      margin:0 auto 30px;">
                Build your skills, explore internship opportunities,
                and manage your student profile in one place.
            </p>


            <!-- FEATURES -->
            <div style="display:flex;
                        justify-content:center;
                        gap:20px;
                        flex-wrap:wrap;
                        margin-bottom:35px;">

                <div style="width:200px;
                            background:#f0fdf4;
                            border:1px solid #bbf7d0;
                            padding:18px;
                            border-radius:8px;">

                    <h3 style="color:#166534;
                               margin-top:0;">
                        Manage Skills
                    </h3>

                    <p style="color:#6b7280;
                              font-size:14px;">
                        Add and manage your technical skills.
                    </p>

                </div>


                <div style="width:200px;
                            background:#f0fdf4;
                            border:1px solid #bbf7d0;
                            padding:18px;
                            border-radius:8px;">

                    <h3 style="color:#166534;
                               margin-top:0;">
                        Find Internships
                    </h3>

                    <p style="color:#6b7280;
                              font-size:14px;">
                        View available internship opportunities.
                    </p>

                </div>


                <div style="width:200px;
                            background:#f0fdf4;
                            border:1px solid #bbf7d0;
                            padding:18px;
                            border-radius:8px;">

                    <h3 style="color:#166534;
                               margin-top:0;">
                        Student Profile
                    </h3>

                    <p style="color:#6b7280;
                              font-size:14px;">
                        Keep your academic information organized.
                    </p>

                </div>

            </div>


            <!-- BUTTONS -->
            <div>

                <a href="login.jsp"
                     style="display:inline-block;
                             background:#16a34a;
                             color:white;
                             padding:12px 28px;
                             margin:5px;
                             text-decoration:none;
                             border-radius:6px;
                             font-weight:bold;">
    Student Login
</a>

                <a href="register.jsp"
                   style="display:inline-block;
                          background:#ffffff;
                          color:#166534;
                          padding:11px 27px;
                          margin:5px;
                          text-decoration:none;
                          border:1px solid #16a34a;
                          border-radius:6px;
                          font-weight:bold;">
                    Create Account
                </a>

            </div>


            <!-- ADMIN -->
            <div style="margin-top:25px;">

                <a href="adminLogin.jsp"
                   style="color:#166534;
                          text-decoration:none;
                          font-size:14px;
                          font-weight:bold;">
                    Admin Login
                </a>

            </div>

        </div>

    </div>

</body>
</html>